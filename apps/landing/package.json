{
  "name": "landing",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "sourceRoot": "apps/landing",
    "targets": {
      "next:dev": {
        "options": {
          "command": "next dev --port 3001"
        }
      },
      "next:start": {
        "options": {
          "command": "next start --port 3001"
        }
      },
      "test": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test app/talk/inquiry.test.ts",
          "cwd": "{projectRoot}"
        }
      }
    }
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.34.1"
  },
  "scripts": {
    "dev": "nx next:dev",
    "build": "nx next:build",
    "start": "nx next:start",
    "lint": "eslint"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "~6.0.3"
  }
}
